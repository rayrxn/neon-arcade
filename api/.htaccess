# Semua request /api/* → index.php. Folder lib/ tidak boleh diakses langsung.
Options -Indexes
DirectoryIndex index.php
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^lib/ - [F,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L,QSA]
</IfModule>
<FilesMatch "\.(sql|md|json|lock)$">
  Require all denied
</FilesMatch>
